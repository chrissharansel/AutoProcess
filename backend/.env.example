MONGODB_URI="mongodb://127.0.0.1:27017/autoprocess"
JWT_SECRET="change-this-secret"
PORT=4000
UPLOAD_DIR="./uploads"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:latest"
# Optional: full path if Tesseract is not in PATH
# TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_LANG="eng"
OCR_MAX_PAGES=10

# Python executable used to render PDF pages with PyMuPDF
PYTHON_EXECUTABLE="python"
PDF_RENDER_DPI=180

# Oracle EBS PO/vendor details lookup (GET ?po_number=... or ?supplier_name=...)
ORACLE_PO_DETAILS_URL="https://ispdev.petmate.com:8500/apex/rest/get/podetails/"
ORACLE_PO_API_TIMEOUT_MS=20000
# Optional, only if the Oracle REST endpoint requires bearer authentication
# ORACLE_PO_API_BEARER_TOKEN="your-token"
