MONGODB_URI="mongodb://127.0.0.1:27017/autoprocess"
JWT_SECRET="change-this-secret"
PORT=4000
UPLOAD_DIR="./uploads"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:latest"
# Optional: full path if Tesseract is not in PATH
# TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_LANG="eng"
OCR_MAX_PAGES=10

# Python executable used to render PDF pages with PyMuPDF
PYTHON_EXECUTABLE="python"
PDF_RENDER_DPI=180
