MONGODB_URI="mongodb://127.0.0.1:27017/autoprocess"
JWT_SECRET="change-this-secret"
PORT=4000
UPLOAD_DIR="./uploads"

# GitHub Copilot CLI — same authentication approach as ApplyAI
# Install once: npm install -g @github/copilot
# Authenticate: gh auth login OR run `copilot` and use `/login`
COPILOT_BIN="copilot"
# Leave blank to use the Copilot CLI default model. Optional: set a model your plan supports.
COPILOT_MODEL=""
COPILOT_TIMEOUT="240"
COPILOT_CONCURRENCY="2"

TESSERACT_LANG="eng"
OCR_MAX_PAGES="10"
PYTHON_EXECUTABLE="python"
PDF_RENDER_DPI="180"

ORACLE_PO_DETAILS_URL="https://ispdev.petmate.com:8500/apex/rest/get/podetails/"
ORACLE_PO_API_TIMEOUT_MS="20000"
ORACLE_PO_API_USERNAME="your_username"
ORACLE_PO_API_PASSWORD="your_password"

AGENT_TOOL_TIMEOUT_MS="20000"
AGENT_LLM_TIMEOUT_MS="240000"
