MONGODB_URI="mongodb://127.0.0.1:27017/autoprocess"
JWT_SECRET="change-this-secret"
PORT=4000
UPLOAD_DIR="./uploads"

# GitHub Copilot CLI — uses your existing Copilot CLI login session.
# Install: npm install -g @github/copilot
# Authenticate: gh auth login OR run `copilot` then `/login`
COPILOT_BIN="copilot"
# Leave blank to use the CLI default model; optionally set a model available to your account.
COPILOT_MODEL="auto"
# Seconds (240 = 4 minutes)
COPILOT_TIMEOUT=240
AGENT_LLM_TIMEOUT_MS=240000
AGENT_TOOL_TIMEOUT_MS=20000

# Oracle PO/vendor details lookup
ORACLE_PO_DETAILS_URL="https://ispdev.petmate.com:8500/apex/rest/get/podetails/"
ORACLE_PO_API_TIMEOUT_MS=20000
ORACLE_PO_API_USERNAME="your_username"
ORACLE_PO_API_PASSWORD="your_password"

TOOL_ALLOWED_HOSTS=""
TOOL_STRICT_ALLOWLIST=false
TOOL_TLS_INSECURE_HOSTS=""
TOOL_ENV_ALLOWLIST=""
MAX_UPLOAD_MB=25
RATE_LIMIT_MAX=3000

# OCR for scanned PDFs and image invoices
# Install Python packages: python -m pip install -r requirements-ocr.txt
# Install Tesseract OCR engine separately on Windows.
PYTHON_BIN="python"
TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
TESSERACT_LANG="eng"
OCR_MAX_PAGES=20
PDF_RENDER_DPI=250
OCR_TIMEOUT_MS=180000
