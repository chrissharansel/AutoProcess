MONGODB_URI="mongodb://127.0.0.1:27017/autoprocess"
JWT_SECRET="change-this-secret"
PORT=4000
UPLOAD_DIR="./uploads"

# ——— GitHub Copilot LLM (replaces Ollama) ———
# Run a local OpenAI-compatible proxy that uses your Copilot subscription, e.g.:
#   npx @jeffreycao/copilot-api@latest start
# Default listens on http://127.0.0.1:4141
COPILOT_BASE_URL="http://127.0.0.1:4141"
COPILOT_MODEL="gpt-4o"
# Optional if your proxy requires a token:
# COPILOT_API_KEY=""
# GITHUB_TOKEN=""

# OCR / PDF (still local — not cloud AI)
# TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_LANG="eng"
OCR_MAX_PAGES="10"
PYTHON_EXECUTABLE="python"
PDF_RENDER_DPI="180"

# Oracle EBS PO/vendor details
ORACLE_PO_DETAILS_URL="https://ispdev.petmate.com:8500/apex/rest/get/podetails/"
ORACLE_PO_API_TIMEOUT_MS="20000"
ORACLE_PO_API_USERNAME="your_username"
ORACLE_PO_API_PASSWORD="your_password"

AGENT_TOOL_TIMEOUT_MS="20000"
AGENT_LLM_TIMEOUT_MS="120000"
